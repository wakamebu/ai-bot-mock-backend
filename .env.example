PORT=3001

DB_HOST=localhost
DB_PORT=5433
DB_USER=aibot
DB_PASSWORD=aibot
DB_NAME=aibot
# 開発時のみ true（エンティティから自動でテーブル作成）
DB_SYNCHRONIZE=true

# デモテナント（publicKey: pk_demo_clinic）を起動時に作成する
SEED_DEMO=true
# デモテナントの方式（mock / dify）
DEMO_PROVIDER=mock

# Dify。テナントごとの接続先はテナントの providerConfig（baseUrl・apiKey・datasetId・datasetApiKey）に入れる。
# DIFY_PROVISIONER_URL を指定すると、資料を最初に登録したときに偽の Dify（npm run fake:dify）にテナント用のインスタンスを作る
DIFY_PROVISIONER_URL=http://localhost:5101
DIFY_TIMEOUT_MS=60000
