PORT=3001

DB_HOST=localhost
DB_PORT=5433
DB_USER=aibot
DB_PASSWORD=aibot
DB_NAME=aibot
# 開発時のみ true（エンティティから自動でテーブル作成）
DB_SYNCHRONIZE=true

# デモテナント（publicKey: pk_demo_clinic）を起動時に作成する
SEED_DEMO=true
# デモテナントの方式（mock / openai）
DEMO_PROVIDER=mock

# OpenAI。本物を使うときは OPENAI_BASE_URL を空にして API キーを入れる。
# 偽の OpenAI（npm run fake:openai）を使うときは、API キーは何でもよい
OPENAI_API_KEY=fake
OPENAI_BASE_URL=http://localhost:5102/v1
OPENAI_MODEL=gpt-5-mini
# gpt-5 系の推論の量（minimal / low / medium / high）。空ならモデルの既定
OPENAI_REASONING_EFFORT=
